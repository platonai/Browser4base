<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.platon.pulsar</groupId>
        <artifactId>pulsar</artifactId>
        <version>4.10.1-SNAPSHOT</version>
    </parent>

    <artifactId>pulsar-coverage-report</artifactId>
    <packaging>pom</packaging>

    <name>Pulsar Coverage Report</name>
    <description>Aggregates JaCoCo coverage data across all Pulsar modules into a single report</description>

    <!--
    Depend on all production modules and test modules so that
    jacoco:report-aggregate can collect their class files and exec data.

    Note: only pulsar-common, pulsar-parse, pulsar-persist, pulsar-skeleton,
    pulsar-resources, and pulsar-protocol are managed by the parent POM's
    dependencyManagement. All others need explicit ${project.version}.
    -->
    <dependencies>
        <!-- Production modules -->
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-browser</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-common</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-dom</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-persist</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-persist-mongo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-parse</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-ql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-ql-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-skeleton</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-llm</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-boot</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-tests-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-resources</artifactId>
        </dependency>

        <!-- Test-only modules (their exec files capture coverage of prod modules) -->
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-common-tests</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-dom-tests</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-ql-tests</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
        Integration & E2E test modules are NOT included by default since they
        are only in the reactor when -DrunITs=true or -DrunE2Es=true.
        To include them, add the appropriate profile:
          mvn clean verify -Pcoverage-report,tests-integration,tests-e2e
        and uncomment the dependencies below.
        -->
        <!--
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-it-tests</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.platon.pulsar</groupId>
            <artifactId>pulsar-e2e-tests</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <title>Browser4 Base — Aggregate Test Coverage</title>
                            <footer>Generated by JaCoCo aggregate report. Run: mvn clean verify -Pcoverage-report</footer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
